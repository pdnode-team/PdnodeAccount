{
  "$schema": "https://schema.railpack.com",
  "provider": "golang",
  "packages": {
    "go": "1.27",
    "node": "24",
    "pnpm": "11"
  },
  "steps": {
    "build": {
      "commands": [
        "cd ui && pnpm install --frozen-lockfile && pnpm approve-builds --all && pnpm run build",
        "..."
      ]
    }
  },
  "deploy": {
    "startCommand": "./out migrate up && ./out serve --http=0.0.0.0:8090"
  }
}
